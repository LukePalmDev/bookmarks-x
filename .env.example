# ====================================================================
# Configurazione X-Gemini Bookmarks
# ====================================================================

# Chiave API Google Gemini (Google AI Studio)
# Ottienila gratuitamente in 30 secondi con il tuo account Google qui:
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# (Opzionale) Credenziali X / Twitter
# Di default il software legge automaticamente i cookie attivi da Safari su Mac!
# Se preferisci specificarli a mano, puoi estrarli da x.com (Strumenti sviluppatore -> Application -> Cookies):
# X_AUTH_TOKEN=
# X_CT0=

# Telegram. TELEGRAM_ENABLED=false è la modalità no-send per una prova locale.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=true
# TELEGRAM_NOTIFY=true

# Ollama è opzionale. Il default in config/config.yaml resta engine=claude.
# Il tag già installato sul mini è gemma4:12b-it-q4_K_M. Non scaricare altri modelli.
# OLLAMA_MODEL=gemma4:12b-it-q4_K_M
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# ANALYZER_ENGINE=claude
